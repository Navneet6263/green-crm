{
  "name": "greencrm-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.3.0 <25" },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-isolation=none tests/*.test.ts",
    "check:files": "node scripts/check-file-size.mjs",
    "check:versions": "expo install --check",
    "bundle:mobile": "expo export --platform android --platform ios --max-workers 2",
    "verify": "npm run typecheck && npm test && npm run check:files && npm run check:versions"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-task-manager": "~57.0.19",
    "expo-updates": "~57.0.23",
    "expo-sqlite": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
