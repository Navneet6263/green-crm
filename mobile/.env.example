# Public app setting, NOT a secret. Default below is the LIVE CRM.
# Use an approved test backend/account before testing record writes.
# Physical phone: use your computer's LAN IP; localhost is the phone itself.
# Android emulator example: http://10.0.2.2:5000/api
# Release builds require HTTPS. Do not put DB credentials/API secrets here.
EXPO_PUBLIC_API_URL=https://greencall.online/api

# Android native Maps SDK only. Set the same variable in EAS's preview environment.
# Restrict this client key to com.greencall.field.dev + signing SHA-1 and Maps SDK for Android.
# No Map ID, Routes, Places, Geocoding, Navigation or Street View APIs are needed.
GOOGLE_MAPS_ANDROID_API_KEY=
